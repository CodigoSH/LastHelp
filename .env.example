# Every environment variable LastHelp reads. There are no others: one package
# reads the environment and an architecture test fails the build if any other
# one starts to.

# Listening address. A bare port is accepted too.
LASTHELP_PORT=8080
# LASTHELP_ADDR=127.0.0.1:8080

# Where the SQLite database lives. The directory must exist.
LASTHELP_DB_FILE=lasthelp.db

# text (default) or json.
LASTHELP_LOG_FORMAT=text

# Set to true only when a reverse proxy really sits in front. LastHelp then
# reads the client address from X-Forwarded-For — from the entry *our* proxy
# appended, never the leftmost one, which the caller writes and could use to
# mint a fresh rate-limit bucket for every request.
LASTHELP_TRUST_PROXY=false

# How many proxies sit in front. One is the normal case.
LASTHELP_TRUST_PROXY_HOPS=1

# Stops every outbound connection: no forge calls, no notifications. It exists
# so the claim that this server only talks to what you configured is something
# you can check rather than take on trust.
LASTHELP_OFFLINE=false
