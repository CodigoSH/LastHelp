# Every environment variable LastHelp reads. There are no others: one package
# reads the environment and an architecture test fails the build if any other
# one starts to.

# Listening address. A bare port is accepted too.
LASTHELP_PORT=8080
# LASTHELP_ADDR=127.0.0.1:8080

# Where the SQLite database lives. The directory must exist.
LASTHELP_DB_FILE=lasthelp.db

# text (default) or json.
LASTHELP_LOG_FORMAT=text

# Set to true when a reverse proxy or a tunnel sits in front (Nginx, Nginx Proxy
# Manager, Caddy, Traefik, Pangolin, Cloudflare Tunnel...). Left false behind one,
# every visitor looks like that server: one address in the list of sessions and
# one sign-in limit for everybody. On, LastHelp reads the client address from
# X-Forwarded-For — from the entry *our* proxy appended, never the leftmost one,
# which the caller writes and could use to mint a fresh rate-limit bucket for
# every request — so it stays false when nothing is in front.
LASTHELP_TRUST_PROXY=false

# How many proxies sit in front: 1, unless two are chained (Cloudflare in front
# of Nginx Proxy Manager, say).
LASTHELP_TRUST_PROXY_HOPS=1

# Stops every outbound connection: no forge calls, no notifications. It exists
# so the claim that this server only talks to what you configured is something
# you can check rather than take on trust.
LASTHELP_OFFLINE=false

# Only for upgrading from a version that encrypted the forge credentials.
# Nothing is encrypted at rest any more; on the first start after the upgrade
# the sealed values are moved into the database as they are and the file is
# never read or written again. Defaults to lasthelp.key beside the database,
# which is where the old version put it. Set this only if you moved it.
#
# A fresh install has no key file and never makes one. Delete yours once the
# log has said the values were moved.
# LASTHELP_KEY_FILE=/data/lasthelp.key

# Set by the updater, never by hand. When the binary is replaced, the process
# being replaced hands its listening socket to the new one by this number, so
# the port never closes and nobody is refused while it restarts. It is read once
# at start and cleared; a value written here is ignored unless it names a
# listening socket on the address above.
# LASTHELP_LISTEN_FD=

# Where this instance is reachable from outside. Used to build the links in
# notifications and in the feed, and the addresses in /sitemap.xml. Nothing breaks
# without it — the links are simply left out, and there is no sitemap, which is
# worse and honest.
# LASTHELP_PUBLIC_URL=https://help.example.com

# The optional mail relay. With no host and no from-address, the report form
# never offers the notify-me field: collecting an address nothing can use is
# collecting personal data for nothing.
# LASTHELP_SMTP_HOST=smtp.example.com
# LASTHELP_SMTP_PORT=587
# LASTHELP_SMTP_USERNAME=
# LASTHELP_SMTP_PASSWORD=
# LASTHELP_SMTP_FROM=lasthelp@example.com
# LASTHELP_SMTP_STARTTLS=true
